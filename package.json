{
  "name": "poe2-craft-assistant",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --open /?mock",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "fixtures": "cargo run -q -p craft-api --bin craft-cli -- export-fixtures src/mock/fixtures",
    "setup-updates": "node tools/setup-updates.mjs",
    "release": "node tools/release.mjs",
    "check-release": "node tools/check-release.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.0.0",
    "@fontsource/spectral": "^5.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@xyflow/react": "^12.0.0",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShigenoTV/poe2-craft-assistant.git"
  }
}
