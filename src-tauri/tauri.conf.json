{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoE2 Craft Assistant",
  "version": "0.2.4",
  "identifier": "dev.poe2craft.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "PoE2 Craft Assistant",
        "url": "index.html",
        "width": 1400,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Overlay",
        "url": "overlay.html",
        "width": 400,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "PoE2 Craft Assistant",
    "shortDescription": "Assistant de craft Path of Exile 2",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzQzVDRTVCQUU3MzA5MzIKUldReUNYT3VXODdGcy8rS1ZjTitFRk5pQ0ZreWlkMENCaHkrK2RDSlpheFJiWW1jM1QzTVBzQW4K",
      "endpoints": [
        "https://github.com/ShigenoTV/poe2-craft-assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
